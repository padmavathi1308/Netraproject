<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Library Membership</title>
</head>

<body>

    <!-- Main Heading -->
    <h1>STUDENT PRACTICE: LIBRARY MEMBERSHIP PAGE</h1>
    <h3>Build this page using HTML only. Do not use CSS.</h3>

    <hr>

    <!-- Introduction -->
    <h1>College Library Membership</h1>

    <p>
        Welcome to the <strong>college library</strong>.
        Explore books and build your knowledge.
    </p>

    <p>
        <em>Read the instructions before applying.</em>
    </p>

    <a href="#membership">Go to Membership Form</a>

    <hr>

    <!-- 1. Lists -->
    <h2>1. Lists</h2>

    <h3>Documents Required</h3>

    <ul>
        <li>Student ID card</li>
        <li>Passport-size photograph</li>
    </ul>

    <h3>Application Steps</h3>

    <ol>
        <li>Choose a membership type</li>
        <li>Complete the form</li>
        <li>Visit the library</li>
    </ol>

    <h3>ISBN</h3>

    <dl>
        <dt>ISBN</dt>
        <dd>International Standard Book Number</dd>
    </dl>

    <hr>

    <!-- 2. Library Hours -->
    <h2>2. Library Hours</h2>

    <table border="1">

        <tr>
            <th>Day</th>
            <th>Opening</th>
            <th>Closing</th>
        </tr>

        <tr>
            <td>Monday to Friday</td>
            <td>9:00 AM</td>
            <td>6:00 PM</td>
        </tr>

        <tr>
            <td>Saturday</td>
            <td>9:00 AM</td>
            <td>1:00 PM</td>
        </tr>

    </table>

    <hr>

    <!-- 3. Inline Frame -->
    <h2>3. Inline Frame</h2>

    <iframe
        title="Library notice"
        width="500"
        height="100"
        srcdoc="<h2>Library Notice</h2><p>Return borrowed books within 14 days.</p>">
    </iframe>

    <hr>

    <!-- 4. Membership Form -->
    <h2>4. Membership Form</h2>

    <form id="membership">

        <!-- Full Name -->
        <label for="fullname">Full Name:</label>

        <input
            type="text"
            id="fullname"
            name="fullname"
            required
        >

        <br><br>

        <!-- Email -->
        <label for="email">Email:</label>

        <input
            type="email"
            id="email"
            name="email"
            required
        >

        <br><br>

        <!-- Membership Type -->
        <label for="membershiptype">Membership:</label>

        <select id="membershiptype" name="membershiptype">

            <option value="">Select a type</option>
            <option value="student">Student</option>
            <option value="faculty">Faculty</option>
            <option value="research">Research Scholar</option>

        </select>

        <br><br>

        <!-- Reading Mode -->
        <label>Reading Mode:</label>

        <input
            type="radio"
            id="print"
            name="readingmode"
            value="print"
        >

        <label for="print">Print</label>

        <input
            type="radio"
            id="digital"
            name="readingmode"
            value="digital"
        >

        <label for="digital">Digital</label>

        <br><br>

        <!-- Interests -->
        <label>Interests:</label>

        <input
            type="checkbox"
            id="science"
            name="interests"
            value="science"
        >

        <label for="science">Science</label>

        <input
            type="checkbox"
            id="literature"
            name="interests"
            value="literature"
        >

        <label for="literature">Literature</label>

        <br><br>

        <!-- Book Suggestions -->
        <label for="suggestions">Book Suggestions:</label>

        <br>

        <textarea
            id="suggestions"
            name="suggestions"
            rows="3"
            cols="50">
        </textarea>

        <br><br>

        <!-- Agreement -->
        <input
            type="checkbox"
            id="agreement"
            name="agreement"
            value="yes"
        >

        <label for="agreement">
            I agree to the library rules.
        </label>

        <br><br>

        <!-- Submit and Reset Buttons -->
        <button type="submit">Apply</button>

        <button type="reset">Reset</button>

    </form>

</body>
</html>